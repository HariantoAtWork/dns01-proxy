{
  "name": "acmedns-stack",
  "private": true,
  "type": "module",
  "scripts": {
    "docker:build": "docker compose -f docker-compose.build.yml build",
    "docker:push": "docker compose -f docker-compose.push.yml build --push",
    "docker:up": "docker compose up -d",
    "docker:dev": "docker compose --profile dev up acmedns-stack-dev",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f acmedns-stack"
  }
}
