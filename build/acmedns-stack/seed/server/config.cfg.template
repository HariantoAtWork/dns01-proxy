[general]
# Production template — rendered to $ACMEDNS_DATA_ROOT/server/config.cfg when missing.
# Variables: ${APEX}, ${AUTH_DOMAIN}, ${NSADMIN}. DNS uses AUTH_DOMAIN; TLS cert paths use APEX.
# Code defaults (when a key is omitted) live in server/utils/config.ts DEFAULTS.
# Local `bun run dev` uses seed/server/config.dev.cfg.template instead.

# listen — optional; code default "0.0.0.0:53".
# Docker/production: typically "0.0.0.0:53" (or :53 with CAP_NET_BIND_SERVICE).
# Note that systemd-resolved may reserve port 53 on 127.0.0.53.
# Override host/port via ACME_DNS_LISTEN / DNS_LISTEN or ACME_DNS_PORT / DNS_PORT.
listen = "0.0.0.0:53"
# protocol — optional; code default "both".
# Values: "both", "both4", "both6", "udp", "udp4", "udp6", "tcp", "tcp4", "tcp6".
protocol = "both"
# domain — optional to parse (code default "auth.example.org"); set your real zone for production.
domain = "${AUTH_DOMAIN}"
# nsname — optional to parse (code default "auth.example.org"); set to match your zone NS for production.
nsname = "${AUTH_DOMAIN}"
# nsadmin — optional; code default "admin.example.org". SOA RNAME; @ becomes .
nsadmin = "${NSADMIN}"
# records — optional; code default [] (empty). For ACME DNS-01 include A + NS for the auth domain.
records = [
    # domain pointing to the public IP of your acme-dns server
    # Replace 198.51.100.1 (TEST-NET-2 docs example) with your real public internet IP
    # so Let's Encrypt can follow NS glue / A for ${AUTH_DOMAIN} (or your domain).
    "${AUTH_DOMAIN}. A 198.51.100.1",
    # specify that ${AUTH_DOMAIN} will resolve any *.${AUTH_DOMAIN} records
    "${AUTH_DOMAIN}. NS ${AUTH_DOMAIN}.",
]
# debug — optional; code default false.
debug = false

[database]
# engine — optional; code default "sqlite". Empty value throws. Only sqlite supported (sqlite3 accepted).
engine = "sqlite"
# connection — optional; empty value throws.
# Absolute path under ACMEDNS_DATA_ROOT/server/ for Docker/production.
# Relative paths are resolved from the package root; absolute paths are used as-is.
connection = "/var/lib/acmedns-stack/server/acme-dns.db"
# connection = "postgres://user:password@localhost/acmedns_db"

[api]
# ip — optional; code default "0.0.0.0". Overridable by NITRO_HOST / HOST.
ip = "0.0.0.0"
# disable_registration — optional; code default false.
disable_registration = false
# port — optional; code default "80".
# With tls = "none": HTTP listen port (unless NITRO_PORT / PORT is set).
# With tls = "cert": HTTPS listen port (HTTP stays on 80 or NITRO_PORT / PORT).
port = "80"
# tls — optional; code default "none".
# Supported here: "none", "cert". (Go acme-dns also has letsencrypt / letsencryptstaging — not in this stack.)
# Prefer "none" behind Cloudflare / a reverse proxy that terminates TLS.
tls = "none"
# tls_cert_* — only used when tls = "cert". Paths must exist inside the container.
# Example with the compose LETSENCRYPT_DIR mount:
tls_cert_fullchain = "/etc/letsencrypt/live/${APEX}/fullchain.pem"
tls_cert_privkey = "/etc/letsencrypt/live/${APEX}/privkey.pem"
# corsorigins — optional; code default ["*"].
corsorigins = [
    "*"
]
# use_header — optional; code default false. When true, client IP comes from header_name
# (needed for allowfrom CIDRs behind a reverse proxy / Cloudflare).
use_header = false
# header_name — optional; code default "X-Forwarded-For". Used only if use_header is true.
# Cloudflare often uses "CF-Connecting-IP" or "X-Forwarded-For".
header_name = "X-Forwarded-For"

[logconfig]
# loglevel — optional; code default "info". Values: "error", "warning", "info", "debug".
loglevel = "info"
# logtype — optional; code default "stdout". (file & integrations TODO)
logtype = "stdout"
# logformat — optional; code default "text". Values: "json", "text".
logformat = "text"
