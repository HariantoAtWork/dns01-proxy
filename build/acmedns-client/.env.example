# Path to clientstorage.json (relative or absolute)
CLIENTSTORAGE_DATA=data/clientstorage.json

# acme-dns HTTP API used by the Nuxt server proxy
ACMEDNS_URL=http://acmedns-server

# Default Server URL shown in the Register form
NUXT_PUBLIC_DEFAULT_ACMEDNS_URL=http://acmedns-server

# Optional lock for the UI and APIs. Username is always admin.
# Leave empty for open access. Set a password to require sign-in.
ADMINISTRATOR_PASSWORD=
