networks:
  cloudflared:
    external: true
  tsdproxy:
    external: true

services:
  dns01-proxy:
    networks:
      - default
      - cloudflared
      - tsdproxy
    labels:
      tsdproxy.enable: "true"
      tsdproxy.name: "dns01-proxy"
      tsdproxy.container_port: "1080"  # control plane (UI + acme-dns), not edge :80
    extra_hosts:
      - "host.docker.internal:host-gateway"
