services:
  acmedns-stack:
    image: harianto/acmedns-stack:latest
    container_name: acmedns-stack
    restart: unless-stopped
    ports:
      - "53:53"
      - "53:53/udp"
      - "80:80"       # edge HTTP — Bun reverse proxy
      - "443:443"     # edge HTTPS — Bun reverse proxy (SNI)
      - "1080:1080"   # control HTTP — UI + acme-dns API
      - "1443:1443"   # control HTTPS
    volumes:
      - ./data/acmedns-stack:/var/lib/acmedns-stack  # server/, client/, backup/ (or host /var/lib/acmedns-stack:…)
      - ./data/letsencrypt:/etc/letsencrypt  # live/, staging/, trash/, accounts/
      # - letsencrypt:/etc/letsencrypt  # named-volume alternative
    environment:
      # ── Paths (must match volumes) ──────────────────────────────────────────────
      - ACMEDNS_DATA_ROOT=/var/lib/acmedns-stack
      - ACMEDNS_LETSENCRYPT_DIR=/etc/letsencrypt
      # ── System ──────────────────────────────────────────────────────────────────
      - TZ=${TZ:-UTC}
      - ADMINISTRATOR_PASSWORD=${ADMINISTRATOR_PASSWORD:-}
      # ── Domain (APEX derives auth URL + LE email when unset — see core/env.ts) ───
      - APEX=${APEX:-}
      - AUTH_DOMAIN=${AUTH_DOMAIN:-auth.${APEX}}
      # ── ACME / certs ────────────────────────────────────────────────────────────
      - ACMEDNS_URL=${ACMEDNS_URL:-}
      - LETSENCRYPT_EMAIL=${LETSENCRYPT_EMAIL:-}
      - RENEW_INTERVAL=${RENEW_INTERVAL:-12}
      - CERTS_ACME_DISABLED=${CERTS_ACME_DISABLED:-false}
      - CERTS_RENEW_DISABLED=${CERTS_RENEW_DISABLED:-false}
      # ── Tiny stack (optional — see .wiki/Tiny-stack.md) ───────────────────────
      - ACMEDNS_TINY_DOMAIN=${ACMEDNS_TINY_DOMAIN:-}
      - ACMEDNS_SHARED_MODE=${ACMEDNS_SHARED_MODE:-}
      - ACMEDNS_SHARED_KEY=${ACMEDNS_SHARED_KEY:-}
      - ACMEDNS_PUBLIC_IP=${ACMEDNS_PUBLIC_IP:-}
      - ACMEDNS_PUBLIC_IPV6=${ACMEDNS_PUBLIC_IPV6:-}
      - NUXT_ACME_DNS_DEFAULT_CONFIG=${NUXT_ACME_DNS_DEFAULT_CONFIG:-}
      # ── Frontend (Register form; inherits ACMEDNS_URL unless overridden) ────────
      - NUXT_PUBLIC_DEFAULT_ACMEDNS_URL=${NUXT_PUBLIC_DEFAULT_ACMEDNS_URL:-${ACMEDNS_URL:-}}
    # NET_BIND_SERVICE only needed when not running as root; omit cap_add if the process runs as root.
    cap_add:
      - NET_BIND_SERVICE
