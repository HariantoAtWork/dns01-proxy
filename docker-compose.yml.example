services:
  acmedns-nuxt:
    image: harianto/acmedns-nuxt
    container_name: acmedns-nuxt
    restart: unless-stopped
    ports:
      - "53:53"
      - "53:53/udp"
      - "8080:80"
      - "8443:443"
    volumes:
      - ./data/acmedns-server/config:/etc/acme-dns  # acme-dns config.cfg, listen address, auth zone
      - ./data/acmedns-server/data:/var/lib/acme-dns  # SQLite DB for acme-dns accounts and TXT records
      - acmedns-client:/app/config:rw  # clientstorage.json and cert UI settings
      - acmedns-client-data:/app/data:rw  # Nuxt app data root and backups
      - letsencrypt:/etc/letsencrypt  # certbot PEM output (live, staging, trash)
      - ./data/acmedns-letsencrypt:/config/host  # domains.txt edited on host or in Certs UI
    environment:
      # system
      - TZ=${TZ:-UTC}
      - ADMINISTRATOR_PASSWORD=${ADMINISTRATOR_PASSWORD:-}
      # backend
      - NUXT_ACME_DNS_CONFIG=/etc/acme-dns/config.cfg
      - ACMEDNS_URL=${ACMEDNS_URL:-http://127.0.0.1}
      - CLIENTSTORAGE_DATA=/app/config/clientstorage.json
      - NUXT_APPLICATIONS_DATA_ROOT=${NUXT_APPLICATIONS_DATA_ROOT:-/app/data}
      - DOMAINS_FILE=/config/host/domains.txt
      - CERTBOT_CONFIG_DIR=/etc/letsencrypt
      - LETSENCRYPT_EMAIL=${LETSENCRYPT_EMAIL:-admin@example.com}
      - RENEW_INTERVAL=${RENEW_INTERVAL:-12}
      - CERTS_ACME_ENABLED=${CERTS_ACME_ENABLED:-true}
      # frontend
      - NUXT_PUBLIC_DEFAULT_ACMEDNS_URL=${NUXT_PUBLIC_DEFAULT_ACMEDNS_URL:-http://127.0.0.1}
    # NET_BIND_SERVICE only needed when not running as root; omit cap_add if the process runs as root.
    cap_add:
      - NET_BIND_SERVICE

volumes:
  letsencrypt:
    name: letsencrypt
  acmedns-client:
    name: acmedns-client
  acmedns-client-data:
    name: acmedns-client-data
