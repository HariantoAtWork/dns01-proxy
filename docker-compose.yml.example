services:
  acmedns-server:
    image: harianto/acmedns-server
    container_name: acmedns-server
    restart: unless-stopped
    ports:
      - "53:53"
      - "53:53/udp"
    volumes:
      - ./data/acmedns-server/config:/etc/acme-dns
      - ./data/acmedns-server/data:/var/lib/acme-dns
      - letsencrypt:/etc/letsencrypt:ro
    networks:
      - default

  acmedns-client:
    image: harianto/acmedns-client
    container_name: acmedns-client
    restart: unless-stopped
    ports:
      - "82:3000"
    volumes:
      - acmedns-client:/app/config:rw
      - acmedns-client-data:/app/data:rw
      - letsencrypt:/etc/letsencrypt
      - ./data/acmedns-letsencrypt:/config/host
    environment:
      - CLIENTSTORAGE_DATA=/app/config/clientstorage.json
      - NUXT_APPLICATIONS_DATA_ROOT=${NUXT_APPLICATIONS_DATA_ROOT:-/app/data}
      - ACMEDNS_URL=${ACMEDNS_URL:-http://acmedns-server}
      - NUXT_PUBLIC_DEFAULT_ACMEDNS_URL=${ACMEDNS_URL:-http://acmedns-server}
      - ADMINISTRATOR_PASSWORD=${ADMINISTRATOR_PASSWORD:-}
      - DOMAINS_FILE=/config/host/domains.txt
      - CERTBOT_CONFIG_DIR=/etc/letsencrypt
      - LETSENCRYPT_EMAIL=${LETSENCRYPT_EMAIL:-admin@example.com}
      - RENEW_INTERVAL=${RENEW_INTERVAL:-12}
      - CERTS_ACME_ENABLED=${CERTS_ACME_ENABLED:-true}
      - TZ=${TZ:-UTC}
    entrypoint:
      - /bin/sh
      - -c
      - |
          set -e
          file="$${CLIENTSTORAGE_DATA:?CLIENTSTORAGE_DATA is required}"
          mkdir -p "$$(dirname "$$file")"
          if [ ! -s "$$file" ]; then
            echo '{}' > "$$file"
          fi
          mkdir -p /config/host /etc/letsencrypt
          exec bun .output/server/index.mjs
    depends_on:
      - acmedns-server
    networks:
      - default

volumes:
  letsencrypt:
    name: letsencrypt
  acmedns-client:
    name: acmedns-client
  acmedns-client-data:
    name: acmedns-client-data
