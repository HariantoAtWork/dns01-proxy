[general]
# Tiny stack template — no per-domain UUID registration.
# Variables: ${APEX}, ${AUTH_DOMAIN}, ${NSADMIN}.
# Set the auth zone via ACMEDNS_TINY_DOMAIN (overrides domain + nsname at runtime).
# Point at your registrar: _acme-challenge.example.com CNAME <tiny-domain>
listen = "0.0.0.0:53"
protocol = "both"
domain = "${AUTH_DOMAIN}"
nsname = "${AUTH_DOMAIN}"
nsadmin = "${NSADMIN}"
# Glue A (+ AAAA when IPv6 is detected) + NS + SOA are filled at boot from public addresses.
# Override with ACMEDNS_PUBLIC_IP / ACMEDNS_PUBLIC_IPV6 when auto-detect is wrong.
records = []
debug = false

[database]
engine = "sqlite"
connection = "/var/lib/dns01-proxy/server/acme-dns.db"

[api]
ip = "0.0.0.0"
port = "80"
disable_registration = true
shared_mode = true
shared_username = "00000000-0000-4000-8000-000000000001"
# Optional fixed key (43-char base64url). Otherwise auto-generated on first boot.
# shared_password = ""
# Opt-in: per-authorization dynamic CNAME hop to a UUID TXT terminal (or ACMEDNS_AUTH_HOP=1).
# auth_hop = false
tls = "none"
tls_cert_fullchain = "/etc/letsencrypt/live/${APEX}/fullchain.pem"
tls_cert_privkey = "/etc/letsencrypt/live/${APEX}/privkey.pem"
corsorigins = [
    "*"
]
use_header = false
header_name = "X-Forwarded-For"

[logconfig]
loglevel = "info"
logtype = "stdout"
logformat = "text"
