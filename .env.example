# acme-dns Server Configuration
# Default URL for acme-dns server (used when server_url is not specified in clientstorage.json)
# Also used by acmedns-client as the Register form default and the server-side /register proxy.
# Options:
#   - http://acmedns-server (this stack, internal compose DNS)
#   - http://auth.example.org (public hostname for your self-hosted server)
#   - https://auth.acme-dns.io (public service — two TXT slots per account:
#     apex + one wildcard only, e.g. example.com *.example.com)
# Note: Individual domains can override this via the server_url field in clientstorage.json
ACMEDNS_URL=http://acmedns-server

# Let's Encrypt Configuration
# Email address for Let's Encrypt certificate notifications
LETSENCRYPT_EMAIL=admin@example.com

# Renewal Interval (in hours)
# How often to check for certificate renewal (default: 12 hours)
# Certbot will only renew if certificate is within 30 days of expiry
RENEW_INTERVAL=12

# Timezone
# Examples: UTC, Europe/London, America/New_York, Asia/Jakarta
TZ=UTC

# Path where clientstorage.json is located inside the letsencrypt container
# Mounted from the acmedns-client named volume
STORAGE_PATH=/config/acmedns-client/clientstorage.json

# Optional lock for the Nuxt client (UI + APIs). Username is always admin.
# Leave empty for open access. Set a password to require sign-in.
ADMINISTRATOR_PASSWORD=

# Parent data directory for acmedns-client (server-only). Live JSON stays at
# CLIENTSTORAGE_DATA. Backups go to {NUXT_APPLICATIONS_DATA_ROOT}/acmedns-client/backups
# Leave empty locally to use the live storage directory. Compose defaults to /app/data.
NUXT_APPLICATIONS_DATA_ROOT=
