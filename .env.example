# ── Paths (match compose volumes) ───────────────────────────────────────────

# Flat data tree: server/, client/, backup/
# Production (compose/Dockerfile default): /var/lib/acmedns-stack
# Local `bun run dev` default: .data (via nuxt runtimeConfig)
# ACMEDNS_DATA_ROOT=/var/lib/acmedns-stack

# Let's Encrypt PEM tree (live/, staging/, trash/, accounts/)
# Production default: /etc/letsencrypt
# Local default: .data/letsencrypt
# ACMEDNS_LETSENCRYPT_DIR=/etc/letsencrypt

# ── System ──────────────────────────────────────────────────────────────────

# Timezone — Examples: UTC, Europe/London, America/New_York, Asia/Jakarta
TZ=UTC

# Optional lock for the Nuxt UI + APIs. Username is always admin.
# Leave empty for open access. Set a password to require sign-in.
ADMINISTRATOR_PASSWORD=

# ── ACME / certs ────────────────────────────────────────────────────────────

# Public identity for register/update + the Register form default.
# In the all-in-one image, a URL whose host matches config.cfg `domain`
# (or loopback) still registers in-process; the public URL is what gets stored.
# Options:
#   - http://127.0.0.1 (local only; server_url may still use config domain)
#   - https://127.0.0.1 (same, when api.tls = "cert")
#   - https://auth.example.org (recommended for self-hosted — match config domain)
#   - https://auth.acme-dns.io (public service — two TXT slots per account)
# Domains can still override via server_url in clientstorage.json
ACMEDNS_URL=https://auth.example.org

# Let's Encrypt (handled inside acmedns-nuxt)
LETSENCRYPT_EMAIL=admin@example.org

# How often production renewals are checked (hours).
# Renews only when a live/ cert is within 30 days of expiry.
RENEW_INTERVAL=12

# Set true to disable production issue/renew (live/ + boot renew timer).
# Staging Apply still works so you can test dns-01 without touching live LE.
# Dashboard Settings can override this at runtime via client/app-settings.json.
CERTS_ACME_DISABLED=false

# ── Tiny / shared stack (optional) ───────────────────────────────────────────
#
# No per-domain UUID registration — one CNAME for every apex:
#   _acme-challenge.example.com  CNAME  auth.uti.email
#
# Auth zone for tiny mode (overrides config.cfg domain + nsname; enables shared_mode):
#   ACMEDNS_TINY_DOMAIN=auth.uti.email
#
# Or enable manually via config.cfg (shared_mode = true) or env:
#   ACMEDNS_SHARED_MODE=true
#   ACMEDNS_SHARED_KEY=<40-char /update key>   # optional; auto-generated if omitted
#   ACMEDNS_PUBLIC_IP=<your public IPv4>       # optional; auto-detected when omitted
#   ACMEDNS_PUBLIC_IPV6=<your public IPv6>     # optional; adds AAAA glue when set or detected
#
# When ACMEDNS_TINY_DOMAIN is set and ACMEDNS_URL is omitted, defaults to https://<tiny-domain>.
#
# Use the tiny seed as first-start template (local dev example):
#   NUXT_ACME_DNS_DEFAULT_CONFIG=seed/server/config.tiny.cfg
#
# ── Frontend ────────────────────────────────────────────────────────────────

# Optional override for the Register form only (defaults to ACMEDNS_URL in compose)
# NUXT_PUBLIC_DEFAULT_ACMEDNS_URL=https://auth.example.org

# Runtime UI overrides (after Save in Settings) live on the data volume:
#   $ACMEDNS_DATA_ROOT/client/app-settings.json
#   $ACMEDNS_DATA_ROOT/server/config.cfg
