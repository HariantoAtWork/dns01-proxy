# ── Paths (match compose volumes) ───────────────────────────────────────────

# Flat data tree: server/, client/, backup/
# Production (compose/Dockerfile default): /var/lib/acmedns-stack
# Local `bun run dev` default: .data (via nuxt runtimeConfig)
# ACMEDNS_DATA_ROOT=/var/lib/acmedns-stack

# Let's Encrypt PEM tree (live/, staging/, trash/, accounts/)
# Production default: /etc/letsencrypt
# Local default: .data/letsencrypt
# ACMEDNS_LETSENCRYPT_DIR=/etc/letsencrypt

# ── System ──────────────────────────────────────────────────────────────────

# Timezone — Examples: UTC, Europe/London, America/New_York, Asia/Jakarta
TZ=UTC

# Optional lock for the Nuxt UI + APIs. Username is always admin.
# Leave empty for open access. Set a password to require sign-in.
ADMINISTRATOR_PASSWORD=

# ── Domain ──────────────────────────────────────────────────────────────────
#
# APEX is your registrable domain. AUTH_DOMAIN is the acme-dns auth zone
# (defaults to auth.<APEX>). ${APEX} in AUTH_DOMAIN is expanded by the app;
# compose derives auth.<APEX> when AUTH_DOMAIN is omitted.
#
APEX=example.org
AUTH_DOMAIN=auth.${APEX}

# ── ACME / certs ────────────────────────────────────────────────────────────

# Public identity for register/update + the Register form default.
# In the all-in-one image, a URL whose host matches config.cfg `domain`
# (or loopback) still registers in-process; the public URL is what gets stored.
# Options:
#   - http://127.0.0.1 (local only; server_url may still use config domain)
#   - https://127.0.0.1 (same, when api.tls = "cert")
#   - https://auth.example.org (recommended for self-hosted — match config domain)
#   - https://auth.acme-dns.io (public service — two TXT slots per account)
# Domains can still override via server_url in clientstorage.json
# Omit to derive from AUTH_DOMAIN (https://<AUTH_DOMAIN>):
# ACMEDNS_URL=https://${AUTH_DOMAIN}

# Let's Encrypt (handled inside acmedns-stack)
# Omit to derive admin@<APEX>, or set e.g. admin@${APEX}:
# LETSENCRYPT_EMAIL=admin@${APEX}

# How often production renewals are checked (hours).
# Renews only when a live/ cert is within 30 days of expiry.
RENEW_INTERVAL=12

# Set true to disable production issue/renew (live/ + boot renew timer).
# Staging Apply still works so you can test dns-01 without touching live LE.
# Dashboard Settings can override this at runtime via client/app-settings.json.
CERTS_ACME_DISABLED=false

# Set true to stop only the periodic production renew scheduler.
# Manual Certs → Apply / Force re-issue still work.
CERTS_RENEW_DISABLED=true

# ── Tiny stack (shared mode) ─────────────────────────────────────────────────
#
# Slim path: no Register, no UUID, no clientstorage per domain.
# Full guide: .wiki/Tiny-stack.md
#
# ── Required for tiny (typical) ─────────────────────────────────────────────
#
# Auth zone — the CNAME target for every site you certificate:
#   _acme-challenge.example.com  CNAME  auth.uti.email
#
# Overrides config.cfg domain + nsname and enables shared_mode automatically.
# ACMEDNS_TINY_DOMAIN=auth.uti.email
#
# LETSENCRYPT_EMAIL is required (see ACME / certs above).
#
# ── Optional tiny env ───────────────────────────────────────────────────────
#
# Public URL when not using Register (defaults to https://<ACMEDNS_TINY_DOMAIN>):
# ACMEDNS_URL=https://auth.uti.email
#
# First-start server template (empty glue records; filled at boot):
# NUXT_ACME_DNS_DEFAULT_CONFIG=seed/server/config.tiny.cfg.template
#
# Glue A / AAAA on the auth zone — auto-detected from outbound HTTPS if omitted:
# ACMEDNS_PUBLIC_IP=203.0.113.10
# ACMEDNS_PUBLIC_IPV6=2001:db8::1
#
# ── Advanced: shared /update API key (usually OMIT) ───────────────────────
#
# NOT a DNS record. NOT added in Cloudflare.
# Internal password for POST /update (publishes dns-01 TXT on the auth zone).
# The all-in-one UI issues certs in-process and auto-generates a key on first
# boot — you do not need this for normal Certs → Apply.
#
# Set only when:
#   - an external script/certbot calls https://<tiny-domain>/update, or
#   - you want a fixed key across redeploys (else stored in SQLite on the volume)
#
# Exactly 40 characters: A–Z a–z 0–9 - _
# ACMEDNS_SHARED_KEY=
#
# Force shared mode without ACMEDNS_TINY_DOMAIN (uses domain from config.cfg):
# ACMEDNS_SHARED_MODE=true
#
# ── Frontend ────────────────────────────────────────────────────────────────

# Optional override for the Register form only (defaults to ACMEDNS_URL in compose)
# NUXT_PUBLIC_DEFAULT_ACMEDNS_URL=https://auth.example.org

# Runtime UI overrides (after Save in Settings) live on the data volume:
#   $ACMEDNS_DATA_ROOT/client/app-settings.json
#   $ACMEDNS_DATA_ROOT/server/config.cfg
