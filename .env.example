# acme-dns configuration
# Used by the in-process register/update bridge (and as the Register form default).
# Options:
#   - http://127.0.0.1 (same container, api.tls = "none")
#   - https://127.0.0.1 (same container, api.tls = "cert")
#   - http://auth.example.org (public hostname for your self-hosted server)
#   - https://auth.acme-dns.io (public service — two TXT slots per account)
# Domains can still override via server_url in clientstorage.json
ACMEDNS_URL=http://127.0.0.1
NUXT_PUBLIC_DEFAULT_ACMEDNS_URL=http://127.0.0.1

# Let's Encrypt (handled inside acmedns-nuxt)
LETSENCRYPT_EMAIL=admin@example.com

# How often production renewals are checked (hours).
# Renews only when a live/ cert is within 30 days of expiry.
RENEW_INTERVAL=12

# Set false to disable ACME issue/renew (domains.txt editor still works).
CERTS_ACME_ENABLED=true

# Timezone — Examples: UTC, Europe/London, America/New_York, Asia/Jakarta
TZ=UTC

# Optional lock for the Nuxt UI + APIs. Username is always admin.
# Leave empty for open access. Set a password to require sign-in.
ADMINISTRATOR_PASSWORD=

# Parent data directory for backups (server-only).
# Leave empty locally. Compose defaults to /app/data.
NUXT_APPLICATIONS_DATA_ROOT=
